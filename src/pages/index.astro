---
import { Image } from 'astro:assets';
import heroScene from '../../assets/plates/hero-scene.png';
import projectArt from '../../assets/plates/project-art.png';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mohanad Yehia | Software QA Engineer</title>
    <meta name="description" content="Software QA across web, mobile, API, and data. Explore Mohanad Yehia's production experience, test frameworks, and evidence-backed QA case studies." />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Mohanad Yehia, home">Mohanad Yehia</a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#approach">Approach</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" id="home" aria-labelledby="intro-title">
        <Image class="hero-scene" src={heroScene} alt="" aria-hidden="true" format="webp" quality={85} widths={[640, 1024, 1536, 1751]} sizes="100vw" loading="eager" fetchpriority="high" />
        <h1 id="intro-title"><span>Complex systems.</span><span>Clear evidence.</span></h1>
        <p class="hero-role">Software QA Engineer</p>
        <p class="hero-introduction">Production QA across web, mobile,<br /> API, and data.</p>
        <a class="button work-action" href="#work">Explore the work</a>
        <a class="button resume-action" href="/resume.pdf" download="Mohanad_Yehia_Software_QA_Engineer.pdf">Resume</a>
      </section>
      <section class="featured" id="work" aria-labelledby="testpulse-title">
        <Image class="project-art" src={projectArt} alt="" aria-hidden="true" format="webp" quality={85} widths={[640, 1024, 1536]} sizes="60vw" />
        <p class="work-label">Selected work</p>
        <h2 id="testpulse-title"><a href="/work/testpulse">TestPulse</a></h2>
        <p class="project-summary">Test observability &amp; flake detection</p>
      </section>
    </main>
  </body>
</html>
<style>
  .skip-link { position: absolute; z-index: 20; top: 1rem; left: 1rem; padding: .8rem 1.2rem; color: #171515; background: var(--color-amber); transform: translateY(-200%); }
  .skip-link:focus { transform: translateY(0); }
  .site-header { position: absolute; top: 0; left: 0; width: 100%; padding: 1.15vw 3.4vw; display: flex; justify-content: space-between; align-items: center; z-index: 5; }
  .brand { font-size: 2.02vw; font-weight: 800; letter-spacing: -.055em; line-height: 1.3; }
  nav { display: flex; gap: 3.1vw; align-items: center; font-size: 1.3vw; color: #d0c9bf; }
  nav a { padding: .2rem 0; transition: color .2s; }
  nav a:hover { color: var(--color-amber); }
  .hero { position: relative; aspect-ratio: 1536 / 786; isolation: isolate; overflow: hidden; }
  .hero-scene { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero > :not(img), .featured > :not(img) { z-index: 1; }
  h1 { position: absolute; top: 5.8vw; left: 3.13%; font-size: 9.96vw; line-height: .9; letter-spacing: -.04em; font-weight: 700; transform: scaleX(.93); transform-origin: top left; }
  h1 span { display: block; white-space: nowrap; }
  .hero-role { position: absolute; top: 29.2vw; left: 3.58%; font-size: 1.823vw; line-height: 1.3; letter-spacing: -.035em; }
  .hero-introduction { position: absolute; top: 32.3vw; left: 3.58%; font-size: 1.498vw; line-height: 1.25; letter-spacing: -.025em; color: var(--color-muted); }
  .button { display: inline-flex; justify-content: center; align-items: center; border-radius: .6rem; font-size: 1.25vw; font-weight: 600; line-height: 1.2; transition: background .2s, color .2s; }
  .work-action { position: absolute; left: 3.58%; top: 37.89vw; width: 13.54%; height: 4.1vw; background: linear-gradient(145deg, #ffd17d, #f4a938); color: #17110a; }
  .work-action:hover { background: #ffda98; }
  .resume-action { position: absolute; left: 18.16%; top: 37.89vw; width: 8.92%; height: 4.1vw; border: 1px solid #b1a492; background: #19171470; }
  .resume-action:hover { background: #393027; }
  .featured { position: relative; min-height: 15.5vw; isolation: isolate; overflow: hidden; }
  .project-art { position: absolute; top: 0; left: 40.1%; width: 59.9%; height: 15.5vw; object-fit: cover; z-index: 0; }
  .work-label { position: absolute; top: 1.6vw; left: 3.58%; font-size: 1.3vw; letter-spacing: .09em; color: var(--color-muted); }
  h2 { position: absolute; top: 4.1vw; left: 3.58%; font-size: 6.77vw; font-weight: 700; }
  .project-summary { position: absolute; top: 11.2vw; left: 3.58%; font-size: 1.69vw; line-height: 1.3; color: var(--color-muted); }
</style>
