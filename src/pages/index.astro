---
import BaseLayout from '../layouts/BaseLayout.astro';
import PassThrough from '../components/PassThrough.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Experience from '../components/Experience.astro';
import Approach from '../components/Approach.astro';
import About from '../components/About.astro';
---
<BaseLayout home motion>
  <PassThrough home />
  <div class="journey-continuation">
  <SelectedWork />
  <Experience />
  <Approach />
  <About />
  </div>
</BaseLayout>
<style>.journey-continuation { position: relative; isolation: isolate; overflow: clip; }</style>
