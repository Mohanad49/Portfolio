---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Experience from '../components/Experience.astro';
import Approach from '../components/Approach.astro';
import About from '../components/About.astro';
---
<BaseLayout home>
  <Hero />
  <SelectedWork />
  <Experience />
  <Approach />
  <About />
</BaseLayout>
<script>
  const motionMedia = matchMedia('(min-width: 761px) and (prefers-reduced-motion: no-preference)');
  let started = false;
  const start = () => {
    if (!motionMedia.matches || started) return;
    started = true;
    void import('../scripts/motion').then(module => module.initMotion()).catch(() => { started = false; });
  };
  motionMedia.addEventListener('change', start);
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
  else setTimeout(start, 100);
  window.addEventListener('pagehide', () => motionMedia.removeEventListener('change', start), { once: true });
</script>
