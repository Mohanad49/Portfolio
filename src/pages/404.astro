---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
---
<PageLayout title="Page not found | Mohanad Yehia" noindex>
  <section class="not-found"><p class="error-code" aria-hidden="true">404</p><h1>That page isn’t <em>here.</em></h1><p>The link may have moved. You can return to the portfolio or find a project in the work archive.</p><div><a class="text-link" href="/">Back to the portfolio <Icon /></a><a class="text-link" href="/work">Open the work archive <Icon /></a></div></section>
</PageLayout>
<style>
  .not-found { padding: calc(var(--chrome-h) + clamp(2rem, 5vw, 5rem)) var(--page-gutter) clamp(4rem, 8vw, 8rem); }
  .error-code { font-family: var(--font-serif); font-style: italic; font-weight: 500; color: var(--color-amber); font-size: clamp(7rem, 19vw, 19rem); line-height: 1; letter-spacing: -.02em; font-variant-numeric: lining-nums; }
  h1 { font-size: clamp(2.1rem, 4.4vw, 5rem); font-weight: 700; line-height: 1.02; margin-top: 1.5rem; }
  .not-found > p:not(.error-code) { max-width: 45ch; color: var(--body-copy); font-size: 1.15rem; margin-top: 1.5rem; }
  .not-found > div { display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 2.5rem; }
</style>
