---
import { render, type CollectionEntry } from 'astro:content';
import { getProjects } from '../../lib/content';
import PageLayout from '../../layouts/PageLayout.astro';
import CaseEvidence from '../../components/CaseEvidence.astro';
import Icon from '../../components/Icon.astro';
import MaterialField from '../../components/MaterialField.astro';

export async function getStaticPaths() {
  return (await getProjects()).map(project => ({ params: { slug: project.data.slug }, props: { project } }));
}
interface Props { project: CollectionEntry<'caseStudies'>; }
const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const projects = await getProjects();
const next = projects[data.order % projects.length];
const checkedDate = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(data.evidenceDate));
---
<PageLayout title={`${data.title} | QA case study | Mohanad Yehia`} description={data.summary} motion>
  <div class="reading-progress" aria-hidden="true"></div>
  <header class="page-hero case-hero">
    <div class="page-hero-copy case-introduction">
      <a class="back-link" href="/work"><Icon class="back-icon" /> All work</a>
      <h1 style={`view-transition-name: project-${data.slug}`}>{data.title}</h1>
      <p class="case-context"><span>{data.eyebrow}</span><span>{data.role}</span></p>
      <p class="page-lede case-summary">{data.summary}</p>
      <div class="case-actions"><a class="text-link" href={data.report}>{data.reportLabel} <Icon name="external" /></a><a class="text-link text-link--quiet" href={data.repository}>View source <Icon name="external" /></a></div>
      <p class="case-stack">{data.stack.join(' · ')}</p>
    </div>
    <MaterialField variant="case" shape={data.slug} />
  </header>
  <CaseEvidence slug={data.slug} />
  <div class="case-reading section-space">
    <aside class="case-sidebar">
      <details class="case-jump"><summary>In this case study</summary><nav aria-label="Case study sections">{headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></details>
      <div class="evidence-source"><p>{data.boundary}</p><a class="text-link" href={data.evidence}>Source evidence <Icon name="external" /></a><span>Checked {checkedDate}</span></div>
    </aside>
    <article class="case-prose" aria-label={`${data.title} case study`}><Content /></article>
  </div>
  {next && <nav class="next-case" aria-label="More selected work"><a class="lead-row" href={`/work/${next.data.slug}`}><span><span class="lead-title" style={`view-transition-name: project-${next.data.slug}`}>{next.data.title}</span><span class="next-kind">{next.data.eyebrow}</span></span><Icon /></a></nav>}
</PageLayout>
<style>
  .case-context { display: flex; flex-wrap: wrap; gap: .4rem 2rem; margin-top: 1.1rem; font-size: 1rem; color: var(--color-muted); }
  .case-context span:first-child { color: var(--color-amber); }
  h1 { max-width: 13ch; overflow-wrap: anywhere; }
  .case-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .25rem 2rem; margin-top: clamp(1.6rem, 2.4vw, 2.4rem); }
  .case-actions :global(svg) { width: 18px; height: 18px; }
  .case-stack { max-width: 58ch; margin-top: 1.6rem; font-size: .9rem; color: var(--color-muted); }
  .reading-progress { position: fixed; inset: 0 0 auto; height: 2px; background: var(--color-amber); transform: scaleX(0); transform-origin: left; z-index: 25; pointer-events: none; }
  .case-reading { display: grid; grid-template-columns: 17rem minmax(0, 47rem); gap: clamp(3rem, 9vw, 11rem); justify-content: center; padding-inline: var(--page-gutter); }
  .case-sidebar { position: sticky; top: calc(var(--chrome-h) + 1rem); align-self: start; font-size: .9rem; }
  .case-jump { padding-bottom: 1.6rem; border-bottom: 1px solid var(--line); }
  .case-jump summary { cursor: pointer; font-weight: 600; min-height: 44px; }
  .case-jump nav { display: flex; flex-direction: column; gap: .2rem; padding-block: .5rem 0; color: var(--color-muted); }
  .case-jump nav a { display: flex; align-items: center; min-height: 2.2rem; transition: color .2s; }
  .case-jump a:hover { color: var(--color-amber); }
  .evidence-source { padding-top: 1.6rem; }
  .evidence-source p { color: var(--body-copy); }
  .evidence-source .text-link { margin-top: 1rem; }
  .evidence-source :global(svg) { width: 17px; height: 17px; }
  .evidence-source > span { display: block; margin-top: 1rem; color: var(--color-muted); font-size: .8rem; }
  .case-prose { min-width: 0; font-size: 1.075rem; line-height: 1.85; color: var(--body-copy); }
  .case-prose :global(h2) { font-size: clamp(1.7rem, 2.6vw, 2.9rem); font-weight: 700; margin: 3.5rem 0 1.5rem; color: var(--color-ink); line-height: 1.12; scroll-margin-top: 1rem; }
  .case-prose :global(h2:first-child) { margin-top: 0; }
  .case-prose :global(p) { margin-block: 1rem; }
  .case-prose :global(ul) { padding-left: 1.3rem; }
  .case-prose :global(li) { margin-top: 1rem; padding-left: .4rem; }
  .case-prose :global(li::marker) { color: var(--color-amber); }
  .case-prose :global(strong) { color: var(--color-ink); font-weight: 700; }
  .case-prose :global(a) { text-decoration: underline; text-decoration-color: var(--color-amber); text-underline-offset: 4px; transition: color .2s; }
  .case-prose :global(a:hover) { color: var(--color-amber); }
  .case-prose :global(code) { overflow-wrap: anywhere; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: .9em; color: var(--color-ink); }
  .next-case { margin-inline: var(--page-gutter); padding-bottom: clamp(2rem, 4vw, 4rem); }
  .next-kind { display: block; margin-top: .8rem; font-size: .9rem; color: var(--color-amber); }
  @media (max-width: 900px) { .case-reading { grid-template-columns: minmax(0, 1fr); gap: 3rem; } .case-sidebar { position: static; } .evidence-source { max-width: 65ch; } }
  @media (max-width: 600px) { .case-prose :global(h2) { font-size: clamp(1.25rem, calc(1rem + 3vw), 2.9rem); } }
</style>
