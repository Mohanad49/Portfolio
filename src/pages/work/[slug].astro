---
import { render, type CollectionEntry } from 'astro:content';
import { getProjects } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseEvidence from '../../components/CaseEvidence.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  return (await getProjects()).map(project => ({ params: { slug: project.data.slug }, props: { project } }));
}
interface Props { project: CollectionEntry<'caseStudies'>; }
const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const projects = await getProjects();
const next = projects[data.order % projects.length];
const checkedDate = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(data.evidenceDate));
---
<BaseLayout title={`${data.title} | QA case study | Mohanad Yehia`} description={data.summary}>
  <header class="case-hero">
    <a class="back-link" href="/work"><Icon class="back-icon" /> All work</a>
    <h1>{data.title}</h1>
    <div class="case-context"><span>{data.eyebrow}</span><span>{data.role}</span></div>
    <p class="case-summary">{data.summary}</p>
    <div class="case-actions"><a class="text-link" href={data.report}>{data.reportLabel} <Icon name="external" /></a><a class="source-link" href={data.repository}>View source <Icon name="external" /></a></div>
    <p class="case-stack">{data.stack.join(' · ')}</p>
  </header>
  <CaseEvidence slug={data.slug} />
  <div class="case-reading section-space">
    <aside class="case-sidebar">
      <details class="case-jump"><summary>In this case study</summary><nav aria-label="Case study sections">{headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></details>
      <div class="evidence-source"><p>{data.boundary}</p><a class="text-link" href={data.evidence}>Source evidence <Icon name="external" /></a><span>Checked {checkedDate}</span></div>
    </aside>
    <article class="case-prose" aria-label={`${data.title} case study`}><Content /></article>
  </div>
  {next && <nav class="next-case" aria-label="More selected work"><a href={`/work/${next.data.slug}`}><span>{next.data.title}</span><Icon /></a><p>{next.data.eyebrow}</p></nav>}
</BaseLayout>
<style>
  .case-hero { padding: clamp(2rem, 5vw, 6rem) var(--page-gutter) clamp(3rem, 5vw, 6rem); }
  .back-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-muted); font-size: .9rem; }
  .back-link:hover { color: var(--color-amber); }
  .back-link { gap: .5rem; }
  .back-link :global(svg) { width: 16px; height: 16px; transform: rotate(180deg); }
  .case-context { display: flex; flex-wrap: wrap; gap: .7rem 2rem; margin-top: 1.5rem; font-size: .85rem; color: var(--color-muted); }
  h1 { font-size: clamp(2.8rem, 8vw, 9rem); margin-top: 2.5rem; overflow-wrap: anywhere; }
  .case-summary { font-size: clamp(1.3rem, 2.1vw, 2.3rem); line-height: 1.4; max-width: 42ch; margin-top: 2rem; }
  .case-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 2rem; margin-top: 2.5rem; }
  .source-link { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; font-size: .95rem; color: var(--color-muted); }
  .source-link:hover { color: var(--color-ink); }
  .source-link :global(svg) { width: 18px; height: 18px; }
  .case-stack { font-size: .8rem; color: var(--color-muted); margin-top: 2rem; }
  .case-reading { display: grid; grid-template-columns: 17rem minmax(0, 47rem); gap: clamp(3rem, 9vw, 11rem); justify-content: center; padding-inline: var(--page-gutter); }
  .case-sidebar { position: sticky; top: 2rem; align-self: start; font-size: .85rem; }
  .case-jump { padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
  .case-jump summary { cursor: pointer; font-weight: 600; min-height: 44px; }
  .case-jump nav { display: flex; flex-direction: column; gap: 1rem; padding-block: 1rem 0; color: var(--color-muted); }
  .case-jump a:hover { color: var(--color-amber); }
  .evidence-source { padding-top: 2rem; }
  .evidence-source p { color: #d5cec4; }
  .evidence-source .text-link { margin-top: 1rem; }
  .evidence-source :global(svg) { width: 17px; height: 17px; }
  .evidence-source > span { display: block; margin-top: 1rem; color: var(--color-muted); font-size: .75rem; }
  .case-prose { min-width: 0; font-size: 1.075rem; line-height: 1.85; color: #d5cec4; }
  .case-prose :global(h2) { font-size: clamp(1.7rem, 2.6vw, 2.9rem); margin: 3.5rem 0 1.5rem; color: var(--color-ink); line-height: 1.15; scroll-margin-top: 2rem; }
  .case-prose :global(h2:first-child) { margin-top: 0; }
  .case-prose :global(p) { margin-block: 1rem; }
  .case-prose :global(ul) { padding-left: 1.3rem; }
  .case-prose :global(li) { margin-top: 1rem; padding-left: .4rem; }
  .case-prose :global(li::marker) { color: var(--color-amber); }
  .case-prose :global(strong) { color: var(--color-ink); font-weight: 700; }
  .case-prose :global(a) { text-decoration: underline; text-underline-offset: 4px; }
  .case-prose :global(code) { overflow-wrap: anywhere; font-size: .9em; }
  .next-case { margin-inline: var(--page-gutter); padding-block: 3rem 5rem; border-top: 1px solid var(--line); }
  .next-case > a { display: flex; justify-content: space-between; align-items: center; gap: 2rem; font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 5rem); line-height: 1.2; letter-spacing: -.04em; padding-block: 1.2rem; }
  .next-case :global(svg) { width: 42px; height: 42px; flex-shrink: 0; }
  .next-case > p:last-child { color: var(--color-muted); font-size: .9rem; }
  @media (max-width: 900px) { .case-reading { grid-template-columns: 1fr; gap: 3rem; } .case-sidebar { position: static; } .evidence-source { max-width: 65ch; } }
</style>
