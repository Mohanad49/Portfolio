---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import MaterialField from './MaterialField.astro';
interface Props { profile: CollectionEntry<'profile'>['data']; material?: boolean; }
const { profile, material = false } = Astro.props;
---
<footer id="contact" class="contact section-space">
  {material && <MaterialField variant="closing" />}
  <span id="Contact" class="legacy-anchor" aria-hidden="true"></span>
  <div class="contact-top">
    <h2 class="chapter-title">Let’s talk<br />about quality.</h2>
    <div class="contact-note">
      <p>Have a role, a project, or a testing problem in mind? I’d like to hear about it.</p>
      <a class="text-link" href="/resume.pdf" download="Mohanad_Yehia_Software_QA_Engineer.pdf">Download my resume <Icon name="download" /></a>
    </div>
  </div>
  <div class="email-row">
    <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
    <button class="copy-email" type="button" data-email={profile.email} hidden><Icon name="copy" /><span>Copy email</span></button>
  </div>
  <p class="copy-status" role="status" aria-live="polite"></p>
  <div class="contact-bottom">
    <p>{profile.name}<span>Software QA Engineer · Cairo, Egypt</span></p>
    <div class="social-links"><a href={profile.linkedin}>LinkedIn <Icon name="external" /></a><a href={profile.github}>GitHub <Icon name="external" /></a><a href="#top">Back to top <Icon class="up-icon" /></a></div>
  </div>
</footer>
<script>
  const button = document.querySelector<HTMLButtonElement>('.copy-email');
  const status = document.querySelector<HTMLElement>('.copy-status');
  if (button && status && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '');
        status.textContent = 'Email address copied.';
      } catch {
        status.textContent = 'Copy is unavailable. You can select the email address or open the email link.';
      }
    });
  }
</script>
<style>
  .contact { position: relative; isolation: isolate; overflow: clip; padding-inline: var(--page-gutter); border-top: 1px solid var(--line); background: #151311; }
  .contact-top { display: grid; grid-template-columns: 1.4fr 1fr; gap: 10%; align-items: end; }
  h2 { font-size: clamp(3rem, 6.8vw, 7.5rem); }
  .contact-note { max-width: 27rem; }
  .contact-note p { color: var(--color-muted); font-size: 1.1rem; margin-bottom: 2rem; }
  .email-row { display: flex; justify-content: space-between; align-items: center; gap: 2rem; margin-top: clamp(3rem, 6vw, 6rem); padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .email { font-size: clamp(1.3rem, 3.1vw, 3.5rem); line-height: 1.4; letter-spacing: -.04em; transition: color .2s; overflow-wrap: anywhere; }
  .email:hover { color: var(--color-amber); }
  .copy-email { flex-shrink: 0; display: flex; align-items: center; gap: .7rem; border: 0; background: transparent; color: var(--color-muted); padding: .75rem 0 .75rem 1rem; }
  .copy-email[hidden] { display: none; }
  .copy-email:hover { color: var(--color-ink); }
  .copy-status { min-height: 2.2rem; padding-top: .5rem; color: var(--color-amber); font-size: .85rem; }
  .contact-bottom { display: flex; justify-content: space-between; align-items: end; gap: 2rem; padding-top: 3rem; font-size: .9rem; }
  .contact-bottom p span { display: block; margin-top: .25rem; color: var(--color-muted); }
  .social-links { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem; }
  .social-links a { display: inline-flex; gap: .3rem; align-items: center; min-height: 44px; }
  .social-links :global(svg) { width: 17px; height: 17px; }
  .social-links :global(.up-icon) { transform: rotate(-90deg); }
  @media (max-width: 760px) {
    .contact-top { grid-template-columns: 1fr; gap: 2rem; }
    .contact-note { max-width: 100%; }
    .email-row { align-items: flex-start; flex-direction: column; gap: .5rem; }
    .copy-email { padding-left: 0; }
    .contact-bottom { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .social-links { width: 100%; justify-content: space-between; gap: 1rem; }
  }
</style>
