---
import { getProfile } from '../lib/content';
import Icon from './Icon.astro';
const profile = await getProfile();
---
<section class="experience section-space" id="experience" aria-labelledby="experience-title">
  <div class="experience-heading"><h2 id="experience-title" class="chapter-title">Production QA.<br />Behind the numbers.</h2></div>
  <div class="production-metrics" aria-label="Blue Ribbon production scope" data-reveal>
    <p class="metrics-attribution">Blue Ribbon <span>Production club-management platform</span></p>
    <dl>{profile.metrics.map(metric => <div><dt>{metric.label}<span>{metric.scope}</span></dt><dd>{metric.value}</dd></div>)}</dl>
  </div>
  <div class="experience-list">
    <span class="experience-trace" aria-hidden="true"></span>
    {profile.experience.map((job, index) => <details class="experience-item" open={index === 0}>
      <summary><span class="company">{job.company}</span><span class="job-role">{job.role}<span>{job.period}</span></span><Icon name="plus" /></summary>
      <div class="job-body"><p>{job.summary}</p>{job.highlights.length > 0 && <ul>{job.highlights.map(highlight => <li>{highlight}</li>)}</ul>}</div>
    </details>)}
  </div>
</section>
<style>
  .experience { padding-inline: var(--page-gutter); border-top: 1px solid var(--line); background: #1d1a17; }
  .experience-heading { margin-left: 33%; }
  h2 { font-size: clamp(2.6rem, 4.8vw, 5.5rem); }
  .production-metrics { margin-block: clamp(3rem, 5vw, 5.5rem); }
  .metrics-attribution { font-weight: 600; font-size: .95rem; margin-bottom: 2.5rem; }
  .metrics-attribution span { color: var(--color-muted); font-weight: 400; margin-left: 1rem; }
  dl { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2.2rem; margin: 0; }
  dl > div { display: flex; flex-direction: column; align-items: start; border-left: 1px solid var(--line); padding-left: 1.5rem; }
  dt { font-size: .9rem; color: #d5cec4; order: 1; max-width: 19ch; margin-top: 1rem; }
  dd { font-family: var(--font-display); font-size: clamp(2.6rem, 4.4vw, 5rem); line-height: 1; letter-spacing: -.04em; margin: 0; }
  dt span { display: block; font-size: .72rem; color: var(--color-muted); margin-top: .6rem; }
  .experience-item { border-top: 1px solid var(--line); }
  .experience-list { position: relative; }
  .experience-trace { position: absolute; left: -.8rem; top: 0; bottom: 0; width: 1px; background: var(--color-amber); transform-origin: top; }
  .experience-item:last-child { border-bottom: 1px solid var(--line); }
  summary { display: grid; grid-template-columns: 1fr 1.6fr 24px; align-items: center; gap: 2rem; padding-block: 1.8rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .company { font-family: var(--font-display); font-size: clamp(1.4rem, 2vw, 2.3rem); letter-spacing: -.04em; }
  .job-role { font-size: 1rem; }
  .job-role > span { display: block; font-size: .8rem; color: var(--color-muted); margin-top: .3rem; }
  summary :global(svg) { transition: transform .25s; }
  details[open] summary :global(svg) { transform: rotate(45deg); color: var(--color-amber); }
  .job-body { padding: 0 3rem 2.5rem calc(38.45% + .4rem); max-width: 80rem; color: #d5cec4; }
  .job-body p { max-width: 65ch; }
  ul { padding-left: 1.1rem; margin-block: 1.4rem 0; }
  li { padding-left: .3rem; margin-top: .8rem; font-size: .92rem; }
  li::marker { color: var(--color-amber); }
  @media (max-width: 900px) { .experience-heading { margin-left: 0; } dl { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 1.5rem; } dd { font-size: clamp(1.8rem, 6.8vw, 3.5rem); } dl > div { padding-left: 1rem; } .metrics-attribution span { display: block; margin: .3rem 0 0; } }
  @media (max-width: 600px) {
    dl { grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); }
    h2 { font-size: clamp(1.65rem, calc(1rem + 4vw), 2.6rem); }
    dl { display: flex; flex-wrap: wrap; }
    dl > div { flex: 1 1 max(8rem, 45%); }
    summary { grid-template-columns: 1fr 24px; gap: .8rem; padding-block: 1.5rem; }
    .company { font-size: 1.5rem; }
    .job-role { grid-column: 1; font-size: .9rem; }
    summary :global(svg) { grid-column: 2; grid-row: 1 / span 2; }
    .job-body { padding: 0 0 1.8rem; font-size: .95rem; }
    li { font-size: .9rem; }
  }
</style>
