---
import { Image } from 'astro:assets';
import { getProfile } from '../lib/content';
import inspectionArt from '../../assets/plates/project-art.png';
import InspectionIsland from './InspectionIsland';
const profile = await getProfile();
---
<section class="approach section-space" id="approach" aria-labelledby="approach-title">
  <div class="approach-heading" data-reveal><h2 id="approach-title">Look beneath<br />the interface.</h2></div>
  <div class="approach-body">
    <ul class="approach-steps">{profile.approach.map(step => <li data-reveal><h3>{step.title}</h3><p>{step.description}</p><p class="step-evidence">{step.evidence}</p></li>)}</ul>
    <figure class="inspection-study">
      <div class="inspection-frame"><Image class="inspection-fallback" src={inspectionArt} alt="A conceptual inspection sculpture made from separated dark chrome and amber glass layers." format="webp" quality={85} widths={[640, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" loading="lazy" /><InspectionIsland client:media="(min-width: 1024px) and (prefers-reduced-motion: no-preference)" /></div>
      <figcaption>Layered inspection study <span>Conceptual artwork</span></figcaption>
    </figure>
  </div>
</section>
<style>
  .approach { padding-inline: var(--page-gutter); }
  .approach-heading { margin-bottom: 4rem; }
  h2 { font-size: clamp(2.6rem, 5.5vw, 6rem); }
  .approach-body { display: grid; grid-template-columns: 1fr 1.1fr; gap: 8%; align-items: start; }
  .approach-steps { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--line); padding: 1.7rem 0 2rem; }
  h3 { font-size: clamp(1.4rem, 1.9vw, 2.2rem); }
  li p { margin-top: 1rem; color: #d5cec4; }
  li .step-evidence { color: var(--color-muted); font-size: .8rem; margin-top: .8rem; }
  .inspection-study { position: sticky; top: 2rem; margin: 0; }
  .inspection-frame { position: relative; height: 37rem; background: #110f0e; overflow: hidden; }
  .inspection-fallback { width: 100%; height: 100%; object-fit: cover; object-position: 56% center; }
  .inspection-frame:has(:global([data-ready='true'])) .inspection-fallback { opacity: 0; }
  .inspection-frame :global(astro-island) { display: contents; }
  .inspection-frame :global(.inspection-enhancement) { position: absolute; inset: 0; }
  .inspection-frame :global(.inspection-controls) { position: absolute; bottom: 1rem; left: 1.25rem; right: 1.25rem; display: flex; align-items: end; gap: 1.5rem; padding: 1rem 1.2rem; background: #171411; border: 1px solid var(--line); font-size: .8rem; }
  .inspection-frame :global(.inspection-controls label) { flex: 1; }
  .inspection-frame :global(input[type='range']) { display: block; width: 100%; min-height: 44px; accent-color: var(--color-amber); cursor: pointer; }
  .inspection-frame :global(button) { background: transparent; border: 0; color: var(--color-ink); min-height: 44px; padding: .5rem; }
  figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1rem; font-size: .8rem; color: var(--color-muted); }
  @media (max-width: 1023px) { .approach-body { grid-template-columns: 1fr; gap: 2rem; } .inspection-study { position: static; } .inspection-frame { height: clamp(280px, 60vw, 420px); } .approach-heading { margin-bottom: 2.5rem; } }
  @media (max-width: 600px) { h2 { font-size: 2.3rem; } }
</style>
