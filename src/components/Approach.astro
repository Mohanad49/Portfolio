---
import { Image } from 'astro:assets';
import { getProfile } from '../lib/content';
import inspectionArt from '../../assets/plates/project-art.png';
const profile = await getProfile();
---
<section class="approach section-space" id="approach" aria-labelledby="approach-title">
  <div class="approach-heading" data-reveal><p class="section-label">How I work</p><h2 id="approach-title">Look beneath<br />the interface.</h2></div>
  <div class="approach-body">
    <ol class="approach-steps">{profile.approach.map((step, index) => <li data-reveal><span class="step-index" aria-hidden="true">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p><p class="step-evidence">{step.evidence}</p></div></li>)}</ol>
    <figure class="inspection-study">
      <div class="inspection-frame"><Image class="inspection-fallback" src={inspectionArt} alt="A conceptual inspection sculpture made from separated dark chrome and amber glass layers." format="webp" quality={85} widths={[640, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" loading="lazy" /></div>
      <figcaption>Layered inspection study <span>Conceptual artwork</span></figcaption>
    </figure>
  </div>
</section>
<style>
  .approach { padding-inline: var(--page-gutter); }
  .approach-heading { margin-bottom: 4rem; }
  .approach-heading .section-label { margin-bottom: 1.5rem; }
  h2 { font-size: clamp(2.6rem, 5.5vw, 6rem); }
  .approach-body { display: grid; grid-template-columns: 1fr 1.1fr; gap: 8%; align-items: start; }
  .approach-steps { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; border-top: 1px solid var(--line); padding: 1.7rem 0 2rem; }
  .step-index { color: var(--color-amber); font-size: .8rem; padding-top: .3rem; }
  h3 { font-size: clamp(1.4rem, 1.9vw, 2.2rem); }
  li p { margin-top: 1rem; color: #d5cec4; }
  li .step-evidence { color: var(--color-muted); font-size: .8rem; margin-top: .8rem; }
  .inspection-study { position: sticky; top: 2rem; margin: 0; }
  .inspection-frame { position: relative; height: 37rem; background: #110f0e; overflow: hidden; }
  .inspection-fallback { width: 100%; height: 100%; object-fit: cover; object-position: 56% center; }
  figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1rem; font-size: .8rem; color: var(--color-muted); }
</style>
