---
interface Props { home?: boolean; }
const { home = false } = Astro.props;
const base = home ? '' : '/';
---
<a class="skip-link" href="#main">Skip to content</a>
<header class:list={['site-header', { 'site-header--home': home }]}>
  <a class="brand" href="/" aria-label="Mohanad Yehia, home">Mohanad Yehia</a>
  <nav aria-label="Main navigation">
    <a href={`${base}#work`} aria-current={Astro.url.pathname.startsWith('/work') ? 'page' : undefined}>Work</a>
    <a href={`${base}#approach`}>Approach</a>
    <a href={`${base}#about`}>About</a>
    <a href={`${base}#contact`}>Contact</a>
  </nav>
</header>
<style>
  .skip-link { position: absolute; z-index: 20; top: 1rem; left: 1rem; padding: .8rem 1.2rem; color: #171515; background: var(--color-amber); transform: translateY(-200%); }
  .skip-link:focus { transform: translateY(0); }
  .site-header { position: relative; width: 100%; padding: 1.15vw 3.4vw; display: flex; justify-content: space-between; align-items: center; z-index: 5; }
  .site-header--home { position: absolute; top: 0; left: 0; }
  .brand { font-size: 1.95vw; font-weight: 800; letter-spacing: -.04em; line-height: 1.3; }
  nav { display: flex; gap: 3.1vw; align-items: center; font-size: 1.3vw; color: #d0c9bf; }
  nav a { padding: .2rem 0; transition: color .2s; }
  nav a:hover, nav a[aria-current] { color: var(--color-amber); }
  @media (min-width: 1800px) { .brand { font-size: 2.3rem; } nav { font-size: 1.35rem; } }
  @media (max-width: 1000px) { .brand { font-size: 1.35rem; } nav { font-size: .86rem; gap: 1.8rem; } .site-header { padding-block: 1rem; } .site-header--home { position: relative; } nav a { min-height: 44px; display: inline-flex; align-items: center; } }
  @media (max-width: 600px) {
    .site-header { padding: 1.2rem var(--page-gutter) .8rem; align-items: flex-start; gap: .7rem; flex-direction: column; }
    .brand { font-size: 1.35rem; }
    nav { width: 100%; justify-content: space-between; flex-wrap: wrap; gap: .25rem 1rem; font-size: .86rem; }
    nav a { display: flex; align-items: center; min-height: 44px; }
  }
</style>
