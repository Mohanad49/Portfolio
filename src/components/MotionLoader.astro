<script>
  import { prepareTypography } from '../lib/critical-fonts';
  // Reading pages load their motion once the type is ready, and only where motion is welcome.
  if (document.body.classList.contains('portfolio-surface')) {
    const media = matchMedia('(prefers-reduced-motion: no-preference)');
    let started = false;
    let disposed = false;
    let frame = 0;
    const start = () => {
      if (!media.matches || started) return;
      started = true;
      void prepareTypography().then(async () => {
        if (disposed) return;
        const module = await import('../scripts/motion');
        if (disposed) return;
        // Two frames, so the motion measures a settled layout with the display and text faces.
        frame = requestAnimationFrame(() => {
          frame = requestAnimationFrame(() => { if (!disposed) module.initMotion(); });
        });
      }).catch(() => { started = false; });
    };
    media.addEventListener('change', start);
    // After the first paint, so the motion library never competes with the first screen. A tab
    // opened in the background has no paint to protect and no frames to wait for.
    if (document.visibilityState === 'hidden') start();
    else requestAnimationFrame(() => { frame = requestAnimationFrame(start); });
    function cleanup(event: PageTransitionEvent) {
      if (event.persisted) return;
      disposed = true;
      cancelAnimationFrame(frame);
      media.removeEventListener('change', start);
      window.removeEventListener('pagehide', cleanup);
    }
    window.addEventListener('pagehide', cleanup);
  }
</script>
