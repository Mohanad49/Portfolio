{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/project/1",
      "destination": "/work/testpulse",
      "permanent": true
    },
    {
      "source": "/project/2",
      "destination": "/work/caldiy",
      "permanent": true
    },
    {
      "source": "/project/3",
      "destination": "/work/llm-evaluation",
      "permanent": true
    },
    {
      "source": "/project/4",
      "destination": "/work#orangehrm",
      "permanent": true
    },
    {
      "source": "/project/5",
      "destination": "/work#wikipedia-maestro",
      "permanent": true
    },
    {
      "source": "/project/6",
      "destination": "/work#github-api",
      "permanent": true
    },
    {
      "source": "/project/7",
      "destination": "/work#selenium-web",
      "permanent": true
    },
    {
      "source": "/project/8",
      "destination": "/work#restful-booker",
      "permanent": true
    },
    {
      "source": "/project/9",
      "destination": "/work#jmeter",
      "permanent": true
    },
    {
      "source": "/project/10",
      "destination": "/work#ebay-selenium",
      "permanent": true
    },
    {
      "source": "/project/11",
      "destination": "/work#gamerhq",
      "permanent": true
    },
    {
      "source": "/project/12",
      "destination": "/work#kindle",
      "permanent": true
    },
    {
      "source": "/project/13",
      "destination": "/work#lafefny",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/resume.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
